{
  "dashboard": {
    "id": null,
    "title": "OpenTelemetry Demo Dashboard",
    "tags": ["opentelemetry", "demo"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate by Endpoint",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(otel_demo_requests_requests_total[5m])",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {"displayMode": "list", "orientation": "horizontal"},
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Request Duration by Endpoint",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(otel_demo_request_duration_ms_milliseconds_bucket[5m])",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Total Requests",
        "type": "singlestat",
        "targets": [
          {
            "expr": "sum(otel_demo_requests_requests_total)",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Average Request Duration (ms)",
        "type": "singlestat",
        "targets": [
          {
            "expr": "sum(rate(otel_demo_request_duration_ms_milliseconds_sum[5m])) / sum(rate(otel_demo_request_duration_ms_milliseconds_count[5m]))",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8}
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "refresh": "5s"
  }
}
